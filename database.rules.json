{
  "rules": {
    ".read": false,
    ".write": false,
    "players": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "progress": {
          ".validate": "newData.hasChildren(['xp','coins'])",
          "xp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000000"
          },
          "coins": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000000"
          },
          "games": {
            ".validate": "newData.isNumber()"
          },
          "wins": {
            ".validate": "newData.isNumber()"
          },
          "updated": {
            ".validate": "newData.isNumber()"
          },
          "owned": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length < 40"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "relaisGoogle": {
      "$id": {
        ".read": "$id.length >= 20",
        ".write": "$id.length >= 20 && ((!data.exists() && auth != null) || !newData.exists())",
        ".validate": "!newData.exists() || (newData.child('d').isString() && newData.child('d').val().length < 12000)"
      }
    },
    "relais": {
      "$code": {
        ".read": "$code.length == 4",
        ".write": "$code.length == 4",
        "tv": {
          ".validate": "newData.isNumber()"
        },
        "u": {
          "$m": {
            ".validate": "newData.child('p').isString() && newData.child('p').val().length < 40 && newData.child('j').isString() && newData.child('j').val().length < 100000"
          }
        },
        "d": {
          "$pid": {
            "$m": {
              ".validate": "newData.child('j').isString() && newData.child('j').val().length < 100000"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "social": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "friendCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $other)",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "invites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && (auth.uid === $uid || (auth.uid === $from && root.child('friends/' + $uid + '/' + $from).exists()))"
        }
      }
    },
    "keys": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "entitlements": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
